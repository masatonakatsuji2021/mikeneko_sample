{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "lib": ["es6","dom"],
    "rootDir": "./",
    "outDir": "./dist",
    "paths": {
      "*": [
        "./node_modules/mikeneko-corelib/bin/*",
        "./node_modules/mikeneko-plugin-dialog/bin/*",
        "./node_modules/mikeneko-plugin-validation/bin/*"
      ],
      "app/*" : [ "./src/app/*" ]
    }
  },
  "exclude": [
    "./source/*"
  ]
}